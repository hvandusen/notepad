{
  "name": "notepad",
  "version": "2.0.0",
  "private": true,
  "description": "A shared notepad that starts fresh every day and keeps an archive.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "export-atlas": "node --env-file-if-exists=.env scripts/export-atlas.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "sanitize-html": "^2.17.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "mongodb": "^6.20.0"
  }
}
