<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>notepad · <%= date %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <p><a href="/archive">&larr; past days</a></p>
    <h1><%= date %><% if (isToday) { %> (today, still being written)<% } %></h1>
    <div class="note"><%- html %></div>
  </body>
</html>
